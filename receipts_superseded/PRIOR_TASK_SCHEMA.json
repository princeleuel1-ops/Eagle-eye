{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Eagle Eye Prior Task (prior-task/1.0)",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "tenant_id",
    "disruption_class",
    "as_of_start",
    "as_of_end",
    "entity_refs",
    "observations",
    "intervention",
    "realized",
    "sources",
    "eligibility"
  ],
  "properties": {
    "schema_version": {
      "const": "prior-task/1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "description": "hard tenancy boundary; enforced by registry, selector, compiler, and both verifiers"
    },
    "disruption_class": {
      "type": "string",
      "examples": [
        "port_congestion",
        "supplier_quality",
        "geopolitical"
      ]
    },
    "as_of_start": {
      "type": "string",
      "format": "date"
    },
    "as_of_end": {
      "type": "string",
      "format": "date",
      "description": "task close; every observation must fall inside [as_of_start, as_of_end]; only tasks with as_of_end <= target cutoff are ever visible"
    },
    "entity_refs": {
      "type": "object",
      "properties": {
        "supplier_id": {
          "type": "string"
        },
        "component_id": {
          "type": "string"
        },
        "lane": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "exposure_rate_per_day_usd": {
          "type": "number"
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t",
          "kind",
          "log_delay_days"
        ],
        "properties": {
          "t": {
            "type": "string",
            "format": "date"
          },
          "kind": {
            "const": "shipment_delay_signal"
          },
          "log_delay_days": {
            "type": "number"
          }
        }
      }
    },
    "intervention": {
      "type": "object",
      "required": [
        "id",
        "applied"
      ],
      "properties": {
        "id": {
          "enum": [
            "wait_incumbent",
            "expedite_shipment",
            "activate_alternate",
            "split_order"
          ]
        },
        "applied": {
          "type": "boolean"
        }
      }
    },
    "realized": {
      "type": "object",
      "required": [
        "final_delay_days",
        "log_final_delay",
        "stockout",
        "exposure_usd",
        "recovery_days",
        "intervention_success"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "provenance required (invariant 4)"
    },
    "eligibility": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "closed"
          ]
        }
      }
    }
  }
}